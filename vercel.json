{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/site.html", "destination": "/admin/site.html" },
    { "source": "/site", "destination": "/admin/site.html" },
    { "source": "/projects", "destination": "/projects/index.html" },
    { "source": "/projects/", "destination": "/projects/index.html" },
    { "source": "/projects.html", "destination": "/projects/index.html" },
    { "source": "/store.js", "destination": "/projects/store.js" },
    { "source": "/detail.html", "destination": "/projects/detail.html" }
  ]
}
